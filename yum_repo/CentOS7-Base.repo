[base]
name=CentOS-$releaserver - Base - Vault
baseurl=https://repo.huaweicloud.com/centos-vault/$releasever/os/$basearch/
gpgcheck=1
gpgkey=https://repo.huaweicloud.com/centos-vault/RPM-GPG-KEY-CentOS-7
enabled=1

[updates]
name=CentOS-$releaserver - Updates - Vault
baseurl=https://repo.huaweicloud.com/centos-vault/$releasever/updates/$basearch/
gpgcheck=1
gpgkey=https://repo.huaweicloud.com/centos-vault/RPM-GPG-KEY-CentOS-7
enabled=1

[extras]
name=CentOS-$releaserver - Extras - Vault
baseurl=https://repo.huaweicloud.com/centos-vault/$releasever/extras/$basearch/
gpgcheck=1
gpgkey=https://repo.huaweicloud.com/centos-vault/RPM-GPG-KEY-CentOS-7
enabled=1
